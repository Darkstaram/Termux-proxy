name: Fetch Obsidian Style Settings Plugin

on:
  workflow_dispatch:   # هر وقت خواستی دستی اجرا کن

permissions:
  contents: write      # برای push کردن فایل‌ها به مخزن

jobs:
  fetch-plugin:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Download plugin files from fixed version
        run: |
          curl -L -o main.js \
            https://github.com/obsidian-community/obsidian-style-settings/releases/download/1.0.9/main.js
          curl -L -o manifest.json \
            https://github.com/obsidian-community/obsidian-style-settings/releases/download/1.0.9/manifest.json
          curl -L -o styles.css \
            https://github.com/obsidian-community/obsidian-style-settings/releases/download/1.0.9/styles.css
          
          # اختیاری: بسته‌بندی در یک فایل zip
          zip obsidian-style-settings.zip main.js manifest.json styles.css

      - name: Commit and push to repository
        run: |
          git config user.name "github-actions"
          git config user.email "github-actions@github.com"
          git add main.js manifest.json styles.css obsidian-style-settings.zip
          git commit -m "Update plugin files (v1.0.9)" || echo "No changes to commit"
          git push
